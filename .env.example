# Server runtime port (defaults to 3000)
PORT=3000

# Runtime mode: development | production
NODE_ENV=development

# Cryptographic secret used to HMAC-hash session tokens (REQUIRED in production, min 16 chars)
# Example generation: openssl rand -hex 32
SESSION_SECRET=

# Platform Administrator credentials (required in production; defaults to hackathon demo mode when ENABLE_DEMO_AUTH is active)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional password for seeded demo user (demo@complianceos.local)
DEMO_USER_PASSWORD=

# Explicitly enable/disable hackathon demo shortcuts (true in development, false in production unless opted in)
ENABLE_DEMO_AUTH=true

# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

